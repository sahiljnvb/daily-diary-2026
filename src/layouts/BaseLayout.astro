---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Daily Teacher Diary 2026-27',
  description = 'A daily teaching diary for academic year 2026-27'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-wrapper">
      <header class="site-header">
        <div class="header-inner">
          <div>
            <div class="header-title">
              <a href={import.meta.env.BASE_URL} style="color: inherit; text-decoration: none;">📖 Daily Teacher Diary</a>
            </div>
            <div class="header-subtitle">Academic Year 2026-27 &bull; Aftab Sir</div>
          </div>
          <nav class="header-nav">
            <a href={import.meta.env.BASE_URL}>Home</a>
            <a href={`${import.meta.env.BASE_URL}calendar/`}>Calendar</a>
          </nav>
        </div>
      </header>

      <div class="print-header">
        <h1>Daily Teacher Diary 2026-27</h1>
        <p>Aftab Sir</p>
      </div>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <p>&copy; 2026-27 Daily Teacher Diary &bull; Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></p>
      </footer>
    </div>
  </body>
</html>
